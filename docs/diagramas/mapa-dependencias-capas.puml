@startuml mapa-dependencias-capas
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
title AquaPort Enterprise - Mapa de dependencias entre capas

package "infraestructura" #E8F4F8 {
  rectangle "configuracion" as ic
  rectangle "persistencia" as ip
  rectangle "hidrica" as ih
  rectangle "notificacion" as in
  rectangle "telemetria" as it
  rectangle "zonas" as iz
}

package "aplicacion" #EAF7EF {
  rectangle "AsignadorAutomatico\nPlanificadorRuta\nCoordinadorRuta\nConsultorFlota\nEstadisticasFlota\nRegistradorMisiones" as app
}

package "dominio" #FFF6E5 {
  rectangle "modelo" as dm
  rectangle "puerto" as dp
  rectangle "estrategia" as de
  rectangle "validacion" as dv
  rectangle "telemetria" as dt
  rectangle "fabrica" as df
}

ic --> app
ic --> ip
ic --> ih
ic --> in
ip ..|> dp : implementa
ih ..|> dp : implementa
in ..|> dp : implementa
it ..|> dp : implementa
iz ..|> dp : implementa
app --> dp
app --> dv
app --> de
app --> dt
app --> dm
dv --> dp
dt --> dp
de --> dm
df --> dm
dp --> dm
@enduml
