@startuml c4-contenedores-empoleon
!pragma layout smetana
!include <C4/C4_Container>

title AquaPort Enterprise - Diagrama de contenedores (C4 nivel 2)

Person(operador, "Operador Hídrico", "Supervisa rutas y flota de las 4 zonas")
Person(solicitante, "Solicitante", "Pide transportes multi-etapa")
Person(tecnico, "Técnico de Mantenimiento", "Atiende drones en fallo")

System_Boundary(aquaport, "AquaPort Enterprise") {
  Container(app, "Aplicación AquaPort", "Java 21", "Casos de uso: asignación, planificación y coordinación de rutas multi-etapa, cadena de custodia")
  Container(telemetria, "Módulo de telemetría", "Java 21", "Recibe y guarda la posición, batería y estado de los 60 drones")
  Container(adaptador, "Adaptador API hídrica", "Java 21", "Convierte la respuesta de la API externa al modelo del dominio")
  ContainerDb(bd, "Base de datos de misiones", "PostgreSQL", "Misiones, rutas, tramos y registros de custodia")
}

System_Ext(apiHidrica, "API Condiciones Hídricas", "Lecturas de nivel, turbidez, agitación y profundidad")
System_Ext(centro, "Centro de Control ECI", "Autoriza rutas y recibe el avance")
System_Ext(alertas, "Sistema de Alertas", "Distribuye alertas de fallo")
System_Ext(lims, "Sistema del Laboratorio Hídrico", "Recibe la cadena de custodia de cada muestra")

Rel(solicitante, app, "Solicitud multi-etapa (origen, waypoints, destino, carga)", "HTTPS/JSON")
Rel(operador, app, "Supervisión de rutas y reasignaciones", "HTTPS/JSON")
Rel(app, tecnico, "Orden de mantenimiento", "Correo / HTTPS")
Rel(app, bd, "Lee y guarda misiones, tramos y custodia", "JDBC")
Rel(app, telemetria, "Consulta estado y batería por drone", "Llamada interna")
Rel(telemetria, bd, "Guarda eventos de telemetría", "JDBC")
Rel(app, adaptador, "Condiciones de una zona", "Llamada interna")
Rel(adaptador, apiHidrica, "GET /zones/{code}/conditions", "HTTPS/JSON")
Rel(apiHidrica, adaptador, "waterLevel, turbidity, agitation, depth", "HTTPS/JSON")
Rel(app, centro, "Ruta planificada, llegada a waypoints, reasignaciones", "HTTPS/JSON")
Rel(app, alertas, "Drone en FALLO, ruta FALLIDA", "AMQP")
Rel(app, lims, "Cadena de custodia al entregar", "HTTPS/JSON")

SHOW_LEGEND()
@enduml
